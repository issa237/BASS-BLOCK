{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bassblock.local/schema/block.v1.json",
  "title": "BASS BLOCK block manifest (schema 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "mode", "sdk", "entry"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$",
      "description": "Stable identifier. Lowercase letters, digits and dashes. Must match the block's folder name."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "maxLength": 400 },
    "icon": { "type": "string", "maxLength": 8, "description": "One emoji shown on the block tile." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "mode": {
      "enum": ["web", "polyglot"],
      "description": "'web' for pure HTML/CSS/JS/WASM UI blocks; 'polyglot' for blocks with a local backend in any language (Python, Swift, Rust, C++, Go, Node.js)."
    },
    "sdk": { "type": "string", "pattern": "^\\^?1(\\.\\d+){0,2}$", "description": "SDK range, e.g. ^1.0" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui"],
      "properties": {
        "ui": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.html$" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "run"],
      "description": "Local backend process supervised by BASS BLOCK (used when mode is 'polyglot').",
      "properties": {
        "language": {
          "enum": ["python", "swift", "rust", "cpp", "go", "node", "custom"],
          "description": "Primary language/toolchain required to build and run this backend."
        },
        "protocol": {
          "enum": ["stdio", "http"],
          "default": "stdio",
          "description": "'stdio' for line-delimited JSON-RPC over stdin/stdout (zero dependencies); 'http' for a local server listening on 127.0.0.1:$BB_PORT."
        },
        "build": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          ],
          "description": "Optional compile step run inside the block's code/ folder before starting (e.g. ['swiftc', '-O', 'backend/main.swift', '-o', '.bin/server'])."
        },
        "run": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          ],
          "description": "Command to launch the backend inside the block's code/ folder (e.g. ['python3', '-u', 'backend/main.py'] or ['.bin/server'])."
        },
        "healthPath": {
          "type": "string",
          "pattern": "^/.*",
          "default": "/health",
          "description": "For 'http' protocol backends: GET path polled on 127.0.0.1:$BB_PORT until it returns 2xx."
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": { "enum": ["none", "user-picked-files"], "default": "none" },
        "network": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
              "maxItems": 20
            }
          ],
          "default": false
        },
        "clipboard": { "type": "boolean", "default": false }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": { "$ref": "#/definitions/ports" },
        "outputs": { "$ref": "#/definitions/ports" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "enum": ["macos", "windows", "linux", "any"] },
        "arch": { "type": "array", "items": { "enum": ["arm64", "x64"] } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryMb": { "type": "integer", "minimum": 64, "maximum": 16384 }
      }
    }
  },
  "definitions": {
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_-]{0,31}$" },
          "type": { "type": "string", "pattern": "^[a-z]+/[a-zA-Z0-9.+-]+$" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
